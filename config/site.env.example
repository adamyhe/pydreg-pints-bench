# Copy to config/site.env (git-ignored) and edit. Read by scripts/site.sh and by ppbench (Python).
# Shell syntax; $VARS are expanded. Every setting is optional.

# Slurm. Empty = your Slurm defaults. The sbatch headers carry cbsubscb partitions and the P100 gres;
# override them with extra sbatch flags (applied to every job, then GPU jobs only).
PPB_SLURM_CLUSTER=
PPB_SLURM_ACCOUNT=
PPB_SBATCH_ARGS=                # e.g. --partition=cpu
PPB_GPU_SBATCH_ARGS=            # e.g. --partition=gpu --gres=gpu:a100:1
PPB_SLURM_LOGS=                 # default: logs/slurm in the project

# Node-local scratch for jobs (default /workdir/$USER; falls back to $TMPDIR if not writable).
PPB_SCRATCH_ROOT=

# kentUtils binaries (bigWigToBedGraph, bedGraphToBigWig, bigWigMerge, twoBitToFa, liftOver, ...).
# Default: found on PATH, else /programs/kentUtils/bin.
KENT_BIN=

# dREG-paper inputs from Danko lab storage (see README.md). Leave empty for the public fallbacks.
DREG_K562_HMM_BED=              # hg19.k562.new_hmm2b.post2.bed (K562 GRO-cap HMM TREs; not public)
GM12878_UW_DHS_BED=             # uw.merge.narrowPeak.bed (optional: rebuilt identically from public UCSC files)
